---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const normalize = (path: string) => {
  if (path.length > 1 && path.endsWith('/')) return path.slice(0, -1);
  return path;
};

const normPath = normalize(currentPath);

// Eagerly load sidebar configuration from sidebar.md or sidebar/_index.md (these two only)
const sidebarFiles = import.meta.glob<any>([
  '../content/sidebar.md',
  '../content/sidebar/_index.md'
], { eager: true });
const sidebarEntry = Object.values(sidebarFiles)[0];
const data = sidebarEntry?.frontmatter || {};

// 1. Header Title and Tagline (NO FALLBACK)
const title = data.title;
const tagline = data.tagline ?? data.subtitle ?? data.description;
const taglineLines = tagline 
  ? (typeof tagline === 'string' ? tagline.split('\n') : [String(tagline)]) 
  : [];

// 2. Navigation Items (NO FALLBACK: only render items present in sidebar.md)
const navHeader = data.navHeader ?? data.nav_header;
const rawNav = Array.isArray(data.nav) ? data.nav : [];
const navItems = rawNav
  .map((item: any) => ({
    title: item.title ?? item.label ?? item.name,
    path: item.path ?? item.url ?? item.href
  }))
  .filter((item: any) => Boolean(item.title && item.path));

// Helper to determine active state of navigation links
const isLinkActive = (itemPath: string) => {
  const normItem = normalize(itemPath);
  if (normItem === '/home') {
    return normPath === '/home' || normPath === '' || normPath === '/';
  }
  if (normItem === '/' || normItem === '') {
    return normPath === '' || normPath === '/' || normPath === '/home';
  }
  return normPath === normItem || normPath.startsWith(normItem + '/');
};

// 3. Theme Toggle Button (NO FALLBACK: only render if explicitly configured)
const themeToggle = data.themeToggle ?? data.theme_toggle;
const showThemeToggle = themeToggle === true || (typeof themeToggle === 'object' && themeToggle !== null && themeToggle.enabled !== false);
const themeToggleLabel = (typeof themeToggle === 'object' && themeToggle !== null ? (themeToggle.label ?? themeToggle.text) : undefined) ?? "Toggle Theme";

// 4. External Links Section (NO FALLBACK: only render items present in sidebar.md)
const linksHeader = data.linksHeader ?? data.links_header;
const rawLinks = Array.isArray(data.links) ? data.links : [];
const linksItems = rawLinks
  .map((item: any) => ({
    title: item.title ?? item.label ?? item.name,
    url: item.url ?? item.href ?? item.path,
    target: item.target ?? "_blank",
    rel: item.rel ?? "noreferrer"
  }))
  .filter((item: any) => Boolean(item.title && item.url));

// 5. Copyright Line (NO FALLBACK)
const copyright = data.copyright;
---

<!-- Mobile Top Header (Visible <= 860px) -->
<header class="mobile-header">
  <button 
    id="mobile-brand-toggle" 
    class="mobile-header-brand mono" 
    type="button"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
    aria-controls="main-sidebar"
  >
    <span class="mobile-brand-prompt">&gt;</span>
    <span class="mobile-brand-text">{title || "SYS_ARCHITECT"}</span>
  </button>
</header>

<!-- Mobile Navigation Backdrop Overlay -->
<div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

<!-- Main Navigation Drawer -->
<nav id="main-sidebar" class="sidebar" aria-label="Main Navigation">
  {(title || taglineLines.length > 0) && (
    <div class="sidebar-branding">
      {title && (
        <h2 class="mono" style="font-size: 1.2rem; margin-bottom: 0.5rem;">
          {title}
        </h2>
      )}
      {taglineLines.length > 0 && (
        <p class="text-dim" style="font-size: 0.85rem;">
          {taglineLines.map((line: string, i: number) => (
            <>
              {line}
              {i < taglineLines.length - 1 && <br />}
            </>
          ))}
        </p>
      )}
    </div>
  )}

  {navItems.length > 0 && (
    <div class="nav-section">
      {navHeader && <span class="nav-header">{navHeader}</span>}
      {navItems.map((item: any) => (
        <a 
          href={item.path} 
          class:list={["nav-link", { active: isLinkActive(item.path) }]}
        >
          {item.title}
        </a>
      ))}
    </div>
  )}

  {(showThemeToggle || linksItems.length > 0 || copyright) && (
    <div class="nav-section" style="margin-top: auto;">
      {showThemeToggle && (
        <button id="theme-toggle-btn" class="theme-toggle-btn" type="button">
          [ {themeToggleLabel} ]
        </button>
      )}
      {linksItems.length > 0 && (
        <>
          {linksHeader && <span class="nav-header">{linksHeader}</span>}
          {linksItems.map((item: any) => (
            <a 
              href={item.url} 
              target={item.target} 
              rel={item.rel} 
              class="nav-link"
            >
              {item.title}
            </a>
          ))}
        </>
      )}
      {copyright && (
        <div class="sidebar-copyright mono text-dim" style="font-size: 0.72rem; margin-top: 1.5rem; opacity: 0.6;">
          {copyright}
        </div>
      )}
    </div>
  )}
</nav>

<script>
  function setupNavigationAndTheme() {
    const sidebar = document.getElementById('main-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');
    const brandToggleBtn = document.getElementById('mobile-brand-toggle');
    const desktopThemeBtn = document.getElementById('theme-toggle-btn');

    // Drawer state controls
    function openMenu() {
      if (!sidebar) return;
      sidebar.classList.add('open');
      backdrop?.classList.add('active');
      document.body.classList.add('mobile-nav-open');
      if (brandToggleBtn) {
        brandToggleBtn.setAttribute('aria-expanded', 'true');
      }
    }

    function closeMenu() {
      if (!sidebar) return;
      sidebar.classList.remove('open');
      backdrop?.classList.remove('active');
      document.body.classList.remove('mobile-nav-open');
      if (brandToggleBtn) {
        brandToggleBtn.setAttribute('aria-expanded', 'false');
      }
    }

    function toggleMenu() {
      if (sidebar?.classList.contains('open')) {
        closeMenu();
      } else {
        openMenu();
      }
    }

    brandToggleBtn?.addEventListener('click', toggleMenu);
    backdrop?.addEventListener('click', closeMenu);

    // Auto-close on link click (allows smooth navigation)
    const navLinks = sidebar?.querySelectorAll('.nav-link') || [];
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (window.innerWidth <= 860) {
          closeMenu();
        }
      });
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sidebar?.classList.contains('open')) {
        closeMenu();
      }
    });

    // Theme toggling synchronization
    function updateThemeUI() {
      const isLight = document.body.classList.contains('light-theme');
      if (desktopThemeBtn) {
        desktopThemeBtn.textContent = `[ Toggle ${isLight ? 'Dark' : 'Light'} Mode ]`;
      }
    }

    function toggleTheme() {
      const isLight = document.body.classList.toggle('light-theme');
      if (isLight) {
        document.documentElement.classList.add('light-theme');
      } else {
        document.documentElement.classList.remove('light-theme');
      }
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
      updateThemeUI();
    }

    desktopThemeBtn?.addEventListener('click', toggleTheme);
    updateThemeUI();
  }

  setupNavigationAndTheme();
  document.addEventListener('astro:after-swap', setupNavigationAndTheme);
</script>
