---
import Layout from '../layouts/Layout.astro';

// Eagerly load home page configuration and markdown content from home.md or home/_index.md (these two only)
const homeFiles = import.meta.glob<any>([
  '../content/home.md',
  '../content/home/_index.md'
], { eager: true });

const homeEntry = Object.values(homeFiles)[0];
const frontmatter = homeEntry?.frontmatter || {};
const Content = homeEntry?.Content;
const hasBodyContent = Boolean(homeEntry?.rawContent?.()?.trim());

// NO FALLBACKS: Only render what is explicitly configured in _index.md
const title = frontmatter.title;
const tagline = frontmatter.tagline;
const cardTitle = frontmatter.cardTitle ?? frontmatter.card_title ?? frontmatter.aboutTitle ?? frontmatter.about_title;

const resume = frontmatter.resume;
const resumePath = typeof resume === 'string' ? resume : resume?.path;
const resumePrefix = typeof resume === 'object' 
  ? (resume?.prefix ?? resume?.text) 
  : frontmatter.resumePrefix;
const resumeLabel = typeof resume === 'object' 
  ? (resume?.label ?? resume?.text) 
  : (frontmatter.resumeLabel || resumePath);
const resumeTarget = typeof resume === 'object' ? resume?.target : undefined;

const endpointsTitle = frontmatter.endpointsTitle;
const rawEndpoints = frontmatter.endpoints;
let endpoints: any[] = [];
if (Array.isArray(rawEndpoints)) {
  endpoints = rawEndpoints;
} else if (rawEndpoints && typeof rawEndpoints === 'object') {
  endpoints = Object.entries(rawEndpoints).map(([key, val]: [string, any]) => ({
    label: `${key.toUpperCase()}:`,
    value: typeof val === 'string' ? val : val.value,
    url: typeof val === 'string' ? val : val.url,
    accent: typeof val === 'object' ? val.accent : false
  }));
}

const rawFocusAreas = frontmatter.focusAreas || frontmatter.focus_areas;
const focusAreas = Array.isArray(rawFocusAreas) ? rawFocusAreas : [];

function renderMarkdownLinks(text: string): string {
  if (!text) return '';
  return text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, linkText, url) => {
    const isExternal = url.startsWith('http://') || url.startsWith('https://') || url.startsWith('//');
    const targetRel = isExternal ? ' target="_blank" rel="noreferrer"' : '';
    return `<a href="${url}"${targetRel}>${linkText}</a>`;
  });
}
---

<Layout title={title ? `SYS_ARCHITECT | ${title}` : "SYS_ARCHITECT"}>
  <div>
    {title && <h1 class="mono">{title}</h1>}
    {tagline && (
      <p class="text-dim mb-4" style="max-width: 800px;">
        {tagline}
      </p>
    )}

    {/* Primary Bio & Portfolio Overview Card */}
    {(cardTitle || hasBodyContent || resumePath) && (
      <div class="card mb-8">
        {cardTitle && (
          <div style={hasBodyContent || resumePath ? "margin-bottom: 1.25rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;" : ""}>
            <h2 class="mono" style="font-size: 1.1rem; margin: 0;">
              {cardTitle}
            </h2>
          </div>
        )}

        {hasBodyContent && Content && (
          <div class="text-dim home-prose">
            <Content />
          </div>
        )}

        {/* Redirection to Resume Panel */}
        {resumePath && (
          <div style={hasBodyContent ? "border-top: 1px solid var(--border); padding-top: 1rem; margin-top: 1.5rem;" : ""} class="mono text-dim" style="font-size: 0.85rem;">
            {resumePrefix && <span>{resumePrefix}{resumePrefix.endsWith(' ') ? '' : ' '}</span>}
            <a 
              href={resumePath} 
              target={resumeTarget ?? (resumePath.endsWith('.pdf') ? "_blank" : undefined)}
              rel={resumeTarget === '_blank' || resumePath.endsWith('.pdf') ? "noopener noreferrer" : undefined}
              class="badge tag-link mono" 
              style="color: var(--fg); padding: 0.2rem 0.55rem; font-size: 0.8rem; margin-left: 0.25rem;"
            >
              {resumeLabel || resumePath}
            </a>
          </div>
        )}
      </div>
    )}

    {/* Authorized Endpoints Card */}
    {endpoints && endpoints.length > 0 && (
      <div class="card mb-8">
        {endpointsTitle && (
          <h2 class="mono" style="font-size: 1.1rem; margin-bottom: 1rem;">
            {endpointsTitle}
          </h2>
        )}
        <ul class="mono text-dim" style="list-style: none; display: flex; flex-direction: column; gap: 0.8rem; font-size: 0.9rem; padding: 0; margin: 0;">
          {endpoints.map((ep: any) => (
            <li class="endpoint-row">
              {ep.label && <span class="endpoint-label">{ep.label}</span>}
              <a 
                href={ep.url || ep.href} 
                target={(ep.url || ep.href)?.startsWith('http') ? '_blank' : undefined} 
                rel={(ep.url || ep.href)?.startsWith('http') ? 'noreferrer' : undefined}
                style={ep.accent ? 'color: var(--accent);' : undefined}
                class="endpoint-value"
              >
                {ep.value || ep.url || ep.href}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {/* Focus Areas Grid */}
    {focusAreas && focusAreas.length > 0 && (
      <div class="grid-2 mt-8">
        {focusAreas.map((area: any) => {
          const descHtml = renderMarkdownLinks(area.desc || area.description || '');
          return (
            <div>
              {area.title && <h3 class="mono">{area.title}</h3>}
              {descHtml && <p class="text-dim focus-area-desc" set:html={descHtml} />}
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>

<style>
  .home-prose :global(p) {
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }
  .home-prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .endpoint-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .endpoint-label {
    color: var(--fg);
    min-width: 90px;
    flex-shrink: 0;
  }

  .endpoint-value {
    word-break: break-all;
    overflow-wrap: anywhere;
  }
</style>
</style>
