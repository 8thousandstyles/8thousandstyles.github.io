---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const rawNotes = import.meta.glob<any>('../../content/notes/**/*.md', { eager: true });
  
  const articles: { slugPath: string; category: string; post: any }[] = [];
  const categoriesMap = new Map<string, any[]>();
  const categoryMetaMap = new Map<string, { title?: string; description?: string }>();

  const draftCategories = new Set<string>();

  // 1. Scan for category configuration files: <category>.md or <category>/_index.md (these two only)
  for (const [filepath, mod] of Object.entries(rawNotes)) {
    const relPath = filepath.replace(/^.*\/content\/notes\//, '');
    if (relPath === '_index.md' || relPath === 'notes.md') continue;

    const parts = relPath.split('/');
    if (parts.length === 2 && parts[1] === '_index.md') {
      const cat = parts[0];
      if (mod.frontmatter?.draft === true) {
        draftCategories.add(cat);
        continue;
      }
      categoryMetaMap.set(cat, {
        title: mod.frontmatter?.title,
        description: mod.frontmatter?.description
      });
    } else if (parts.length === 1 && parts[0].endsWith('.md')) {
      const cat = parts[0].replace(/\.md$/, '');
      if (mod.frontmatter?.draft === true) {
        draftCategories.add(cat);
        continue;
      }
      categoryMetaMap.set(cat, {
        title: mod.frontmatter?.title,
        description: mod.frontmatter?.description
      });
    }
  }

  for (const cat of categoryMetaMap.keys()) {
    categoriesMap.set(cat, []);
  }

  // 2. Scan for actual article posts (skip any file starting with '_')
  for (const [filepath, post] of Object.entries(rawNotes)) {
    const filename = filepath.split('/').pop() || '';
    if (filename.startsWith('_')) continue;
    if (post.frontmatter?.draft) continue;

    // filepath example: ../../content/notes/blogs/allocator.md -> blogs/allocator
    const slugPath = filepath.replace(/^.*\/content\/notes\//, '').replace(/\.md$/, '');
    const parts = slugPath.split('/');
    if (parts.length < 2) continue; // Skip category config file if named <cat>.md

    const category = parts[0];
    if (draftCategories.has(category)) continue;

    articles.push({ slugPath, category, post });

    if (!categoriesMap.has(category)) {
      categoriesMap.set(category, []);
    }
    categoriesMap.get(category)!.push({
      slugPath,
      ...post
    });
  }

  // 3. Category paths: /notes/:category (e.g. /notes/blogs, /notes/algorithms)
  const categoryPaths = Array.from(categoriesMap.entries()).map(([category, posts]) => {
    const meta = categoryMetaMap.get(category);
    return {
      params: { slug: category },
      props: {
        isCategory: true,
        category,
        categoryTitle: meta?.title,
        categoryDescription: meta?.description,
        posts
      }
    };
  });

  // 4. Article paths: /notes/:category/:slug (e.g. /notes/blogs/allocator)
  const articlePaths = articles.map(({ slugPath, category, post }) => ({
    params: { slug: slugPath },
    props: {
      isCategory: false,
      category,
      post
    }
  }));

  return [...categoryPaths, ...articlePaths];
}

const { isCategory, category, categoryTitle, categoryDescription, posts, post } = Astro.props;
const categoryDisplayName = categoryTitle || category;
const currentCategoryDesc = categoryDescription;

// For articles: extract TOC headings and author (NO FALLBACK)
let headings: any[] = [];
let author: string | undefined = undefined;

if (!isCategory && post) {
  author = post.frontmatter?.author;
  if (typeof post.getHeadings === 'function') {
    const rawHeadings = await post.getHeadings();
    headings = rawHeadings.filter((h: any) => h.depth >= 2 && h.depth <= 4);
  }
}
---

{isCategory ? (
  <Layout title={`Notes // ${categoryDisplayName} | SYS_ARCHITECT`}>
    <div>
      <a href="/notes" class="mono text-dim" style="font-size: 0.85rem; display: inline-block; margin-bottom: 2rem;">
        ← /notes
      </a>

      <div class="flex" style="justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
        <h1 class="mono" style="margin: 0;">/{category}</h1>
        <span class="badge">{posts.length} {posts.length === 1 ? 'NOTE' : 'NOTES'}</span>
      </div>

      {currentCategoryDesc && (
        <p class="text-dim mb-4">
          {currentCategoryDesc}
        </p>
      )}

      <div class="flex" style="flex-direction: column; gap: 2rem;">
        {posts.map((entry: any) => {
          const { title, date, spec, description, tags } = entry.frontmatter || {};
          const articleUrl = `/notes/${entry.slugPath}`;
          const noteTitle = title || entry.slugPath.split('/').pop();

          return (
            <div class="card">
              <div class="flex" style="justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 class="mono" style="font-size: 1.2rem; margin: 0;">
                  <a href={articleUrl} class="project-title-link">
                    {noteTitle}
                  </a>
                </h2>
                <div class="flex gap-2" style="align-items: center;">
                  {date && <span class="mono text-dim" style="font-size: 0.8rem;">{date}</span>}
                  {spec && <span class="badge">{spec}</span>}
                </div>
              </div>

              {description && (
                <p class="text-dim" style="font-size: 0.95rem; margin-bottom: 0.75rem; line-height: 1.5;">
                  {description}
                </p>
              )}

              {tags && tags.length > 0 && (
                <div class="flex mono" style="gap: 0.75rem; font-size: 0.75rem; margin-top: 1rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                  {tags.map((t: string) => {
                    const tagText = t.startsWith('#') ? t : `#${t}`;
                    return (
                      <span style="color: var(--fg-dim); opacity: 0.8;">
                        {tagText}
                      </span>
                    );
                  })}
                </div>
              )}

              <div class="mono" style="border-top: 1px solid var(--border); padding-top: 0.75rem; margin-top: 1rem; font-size: 0.8rem;">
                <a href={articleUrl} class="tag-link badge">
                  Read →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </Layout>
) : (
  <Layout title={`${post.frontmatter?.title || 'Note'} | SYS_ARCHITECT`}>
    <div class="article-layout">
      <!-- Main Content Column -->
      <div class="article-main">
        <a href={`/notes/${category}`} class="mono text-dim" style="font-size: 0.85rem; display: inline-block; margin-bottom: 2rem;">
          ← /notes/{category}
        </a>

        <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
          {post.frontmatter?.title && (
            <h1 class="mono article-page-title" style="font-size: 1.8rem; margin-bottom: 0.75rem;">
              {post.frontmatter.title}
            </h1>
          )}
          <div class="flex gap-4 mono text-dim" style="font-size: 0.8rem; align-items: center; flex-wrap: wrap;">
            {author && <span>AUTHOR: {author}</span>}
            {post.frontmatter?.date && <span>DATE: {post.frontmatter.date}</span>}
            {post.frontmatter?.spec && <span class="badge">{post.frontmatter.spec}</span>}
          </div>
          {post.frontmatter?.tags && post.frontmatter.tags.length > 0 && (
            <div class="flex mono" style="gap: 0.75rem; font-size: 0.75rem; margin-top: 0.75rem; flex-wrap: wrap;">
              {post.frontmatter.tags.map((t: string) => (
                <span style="color: var(--fg-dim); opacity: 0.8;">
                  {t.startsWith('#') ? t : `#${t}`}
                </span>
              ))}
            </div>
          )}
        </div>

        {/* Mobile Accordion Table of Contents (Visible <= 1024px) */}
        {headings && headings.length > 0 && (
          <details class="mobile-toc-accordion mono card">
            <summary class="mobile-toc-summary">
              <span>[ Table of Contents ({headings.length}) ▾ ]</span>
            </summary>
            <nav class="mobile-toc-nav">
              {headings.map((h: any) => {
                const depthClass = h.depth === 3 ? 'toc-sub' : (h.depth === 4 ? 'toc-h4' : '');
                return (
                  <a 
                    href={`#${h.slug}`} 
                    class={`toc-link mono ${depthClass}`}
                  >
                    {h.text}
                  </a>
                );
              })}
            </nav>
          </details>
        )}

        <div class="blog-article-content text-dim">
          <post.Content />
        </div>
      </div>

      <!-- Opened Right-Side Table of Contents (Desktop only) -->
      {headings && headings.length > 0 && (
        <aside class="article-toc desktop-toc">
          <div class="toc-sticky">
            <span class="mono text-dim toc-header">Table of Contents</span>
            <nav class="toc-nav">
              {headings.map((h: any) => {
                const depthClass = h.depth === 3 ? 'toc-sub' : (h.depth === 4 ? 'toc-h4' : '');
                return (
                  <a 
                    href={`#${h.slug}`} 
                    class={`toc-link mono ${depthClass}`}
                    data-heading={h.slug}
                  >
                    {h.text}
                  </a>
                );
              })}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </Layout>
)}

<script>
  function setupToc() {
    const headings = Array.from(
      document.querySelectorAll('.blog-article-content h2, .blog-article-content h3, .blog-article-content h4')
    ) as HTMLElement[];
    const tocLinks = Array.from(document.querySelectorAll('.desktop-toc .toc-link')) as HTMLAnchorElement[];

    if (!headings.length || !tocLinks.length) return;

    let isManualClick = false;
    let manualTimeout: any = null;
    let ticking = false;

    function applyActiveHighlight(activeSlug: string) {
      if (!activeSlug) return;
      let activeLink: HTMLAnchorElement | null = null;

      tocLinks.forEach((link) => {
        const slug = link.getAttribute('data-heading') || link.getAttribute('href')?.replace('#', '');
        if (slug === activeSlug) {
          link.classList.add('active');
          activeLink = link;
        } else {
          link.classList.remove('active');
        }
      });

      if (activeLink) {
        const tocContainer = document.querySelector('.toc-sticky');
        if (tocContainer) {
          const containerRect = tocContainer.getBoundingClientRect();
          const linkRect = (activeLink as HTMLAnchorElement).getBoundingClientRect();
          if (linkRect.top < containerRect.top || linkRect.bottom > containerRect.bottom) {
            (activeLink as HTMLAnchorElement).scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          }
        }
      }
    }

    function calculateActiveHeading() {
      if (isManualClick) return;

      const triggerOffset = 160;
      let activeSlug = '';

      // Check if user reached absolute bottom of page
      const isAtBottom = (window.innerHeight + window.scrollY) >= (document.documentElement.scrollHeight - 25);

      if (isAtBottom) {
        // Find the lowest heading currently visible in viewport
        for (let i = headings.length - 1; i >= 0; i--) {
          if (headings[i].getBoundingClientRect().top < window.innerHeight) {
            activeSlug = headings[i].id;
            break;
          }
        }
      } else {
        // Standard progression: last heading whose top has crossed the triggerOffset
        for (let i = 0; i < headings.length; i++) {
          const rect = headings[i].getBoundingClientRect();
          if (rect.top <= triggerOffset) {
            activeSlug = headings[i].id;
          } else {
            break;
          }
        }
      }

      if (!activeSlug && headings.length > 0) {
        activeSlug = headings[0].id;
      }

      applyActiveHighlight(activeSlug);
      ticking = false;
    }

    function onScroll() {
      if (isManualClick) return;
      if (!ticking) {
        requestAnimationFrame(calculateActiveHeading);
        ticking = true;
      }
    }

    // 1. Make Article Headings Clickable
    headings.forEach((h) => {
      h.addEventListener('click', () => {
        if (!h.id) return;
        isManualClick = true;
        clearTimeout(manualTimeout);
        history.pushState(null, '', `#${h.id}`);
        applyActiveHighlight(h.id);
        h.scrollIntoView({ behavior: 'smooth' });
        manualTimeout = setTimeout(() => {
          isManualClick = false;
        }, 700);
      });
    });

    // 2. Clickable TOC links immediately update highlight
    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('data-heading') || link.getAttribute('href')?.replace('#', '');
        if (slug) {
          isManualClick = true;
          clearTimeout(manualTimeout);
          applyActiveHighlight(slug);
          manualTimeout = setTimeout(() => {
            isManualClick = false;
          }, 700);
        }
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    
    // Initial check (if arriving with hash in URL, or from top)
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && headings.some(h => h.id === initialHash)) {
      applyActiveHighlight(initialHash);
    } else {
      calculateActiveHeading();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupToc);
  } else {
    setupToc();
  }
  document.addEventListener('astro:after-swap', setupToc);
</script>
