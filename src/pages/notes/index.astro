---
import Layout from '../../layouts/Layout.astro';

interface NoteFrontmatter {
  title?: string;
  date?: string;
  spec?: string;
  description?: string;
  tags?: string[];
  draft?: boolean;
}

// 1. Eagerly load notes top-level configuration from notes.md or notes/_index.md (these two only)
const configFiles = import.meta.glob<any>([
  '../../content/notes.md',
  '../../content/notes/_index.md'
], { eager: true });
const configEntry = Object.values(configFiles)[0];
const config = configEntry?.frontmatter || {};
const Content = configEntry?.Content;
const hasBodyContent = Boolean(configEntry?.rawContent?.()?.trim());

// NO FALLBACKS: Only render what is explicitly configured in .md
const pageTitle = config.title;
const pageDescription = config.description;

// 2. Read category-level metadata from <category>.md or <category>/_index.md (these two only)
const rawNotes = import.meta.glob<any>('../../content/notes/**/*.md', { eager: true });
const categoryMetaMap = new Map<string, { title?: string; description?: string }>();
const draftCategories = new Set<string>();

for (const [filepath, mod] of Object.entries(rawNotes)) {
  const relPath = filepath.replace(/^.*\/content\/notes\//, '');
  if (relPath === '_index.md' || relPath === 'notes.md') continue;
  
  const parts = relPath.split('/');
  if (parts.length === 2 && parts[1] === '_index.md') {
    const cat = parts[0];
    if (mod.frontmatter?.draft === true) {
      draftCategories.add(cat);
      continue;
    }
    categoryMetaMap.set(cat, {
      title: mod.frontmatter?.title,
      description: mod.frontmatter?.description
    });
  } else if (parts.length === 1 && parts[0].endsWith('.md')) {
    const cat = parts[0].replace(/\.md$/, '');
    if (mod.frontmatter?.draft === true) {
      draftCategories.add(cat);
      continue;
    }
    categoryMetaMap.set(cat, {
      title: mod.frontmatter?.title,
      description: mod.frontmatter?.description
    });
  }
}

// 3. Group actual note posts by category subfolder (ignoring any file starting with '_')
const categoriesMap = new Map<string, { count: number; posts: any[] }>();

for (const cat of categoryMetaMap.keys()) {
  categoriesMap.set(cat, { count: 0, posts: [] });
}

for (const [filepath, post] of Object.entries(rawNotes)) {
  const filename = filepath.split('/').pop() || '';
  if (filename.startsWith('_')) continue;
  if (post.frontmatter?.draft) continue;
  
  const relPath = filepath.replace(/^.*\/content\/notes\//, '').replace(/\.md$/, '');
  const parts = relPath.split('/');
  if (parts.length < 2) continue; // Skip top-level category config files if any
  
  const category = parts[0];
  if (draftCategories.has(category)) continue;

  if (!categoriesMap.has(category)) {
    categoriesMap.set(category, { count: 0, posts: [] });
  }

  const catData = categoriesMap.get(category)!;
  catData.count += 1;
  catData.posts.push({
    slugPath: relPath,
    ...post
  });
}

const categories = Array.from(categoriesMap.entries()).map(([key, data]) => {
  const subMeta = categoryMetaMap.get(key);
  return {
    key,
    name: subMeta?.title || key,
    description: subMeta?.description,
    count: data.count,
    posts: data.posts
  };
});
---

<Layout title={pageTitle ? `8THOUSANDSTYLES | ${pageTitle}` : "8THOUSANDSTYLES | Notes"}>
  <div>
    {pageTitle && <h1 class="mono">{pageTitle}</h1>}
    {pageDescription && (
      <p class="text-dim mb-4">
        {pageDescription}
      </p>
    )}

    {hasBodyContent && Content && (
      <div class="card mb-8 text-dim home-prose">
        <Content />
      </div>
    )}

    <!-- Categories Grid -->
    {categories.length > 0 && (
      <div class="flex" style="flex-direction: column; gap: 1.5rem; margin-bottom: 3rem;">
        {categories.map((cat) => (
          <a href={`/notes/${cat.key}`} class="card" style="text-decoration: none; display: block; transition: border-color 0.2s;">
            <div class="flex" style="justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
              <div class="flex" style="align-items: center; gap: 0.75rem;">
                <h2 class="mono" style="font-size: 1.25rem; margin: 0; color: var(--fg);">
                  /{cat.key}
                </h2>
              </div>
              <span class="badge">
                {cat.count} {cat.count === 1 ? 'ENTRY' : 'ENTRIES'}
              </span>
            </div>

            {cat.description && (
              <p class="text-dim mb-2" style="font-size: 0.9rem; margin-bottom: 0.75rem; line-height: 1.5;">
                {cat.description}
              </p>
            )}

            <div class="mono text-dim" style="font-size: 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
              <span style="color: var(--accent);">Browse Category →</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
