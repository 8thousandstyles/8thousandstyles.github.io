---
import Layout from '../../layouts/Layout.astro';
import PicturesView from '../../components/misc/PicturesView.astro';

export async function getStaticPaths() {
  const rawMisc = import.meta.glob<any>('../../content/misc/**/*.md', { eager: true });
  
  const draftCategories = new Set<string>();
  const categoryMetaMap = new Map<string, { title?: string; description?: string; mod: any }>();
  const essaysArticles: { slugPath: string; post: any }[] = [];

  // Pass 1: Identify draft categories
  for (const [filepath, mod] of Object.entries(rawMisc)) {
    const relPath = filepath.replace(/^.*\/content\/misc\//, '');
    if (relPath === '_index.md' || relPath === 'misc.md') continue;

    const parts = relPath.split('/');
    if (parts.length === 2 && parts[1] === '_index.md') {
      if (mod.frontmatter?.draft === true) {
        draftCategories.add(parts[0]);
      }
    } else if (parts.length === 1 && parts[0].endsWith('.md')) {
      if (mod.frontmatter?.draft === true) {
        draftCategories.add(parts[0].replace(/\.md$/, ''));
      }
    }
  }

  // Pass 2: Collect category modules and essay articles
  for (const [filepath, mod] of Object.entries(rawMisc)) {
    const relPath = filepath.replace(/^.*\/content\/misc\//, '');
    if (relPath === '_index.md' || relPath === 'misc.md') continue;

    const parts = relPath.split('/');

    // Category definition files: <cat>/_index.md or <cat>.md
    if (parts.length === 2 && parts[1] === '_index.md') {
      const cat = parts[0];
      if (!draftCategories.has(cat)) {
        categoryMetaMap.set(cat, {
          title: mod.frontmatter?.title,
          description: mod.frontmatter?.description,
          mod
        });
      }
    } else if (parts.length === 1 && parts[0].endsWith('.md')) {
      const cat = parts[0].replace(/\.md$/, '');
      if (!draftCategories.has(cat)) {
        categoryMetaMap.set(cat, {
          title: mod.frontmatter?.title,
          description: mod.frontmatter?.description,
          mod
        });
      }
    } else if (parts.length === 2 && parts[0] === 'essays') {
      // Sub-article inside essays: essays/<slug>.md
      const filename = parts[1];
      if (!filename.startsWith('_') && !mod.frontmatter?.draft && !draftCategories.has('essays')) {
        const slugPath = relPath.replace(/\.md$/, '');
        essaysArticles.push({ slugPath, post: mod });
      }
    }
  }

  const paths: any[] = [];

  // Route 1: essays index (if not draft)
  if (categoryMetaMap.has('essays')) {
    const essaysCat = categoryMetaMap.get('essays')!;
    paths.push({
      params: { slug: 'essays' },
      props: {
        pageType: 'essays-index',
        category: 'essays',
        categoryTitle: essaysCat.title,
        categoryDescription: essaysCat.description,
        categoryMod: essaysCat.mod,
        posts: essaysArticles
      }
    });
  }

  // Route 2: essays articles (essays/:slug)
  for (const { slugPath, post } of essaysArticles) {
    paths.push({
      params: { slug: slugPath },
      props: {
        pageType: 'essay-article',
        category: 'essays',
        post
      }
    });
  }

  // Route 3: all other direct category content pages (pictures, music, yt, art, anime, etc.)
  for (const [category, { title, description, mod }] of categoryMetaMap.entries()) {
    if (category === 'essays') continue; // Handled as listing
    paths.push({
      params: { slug: category },
      props: {
        pageType: 'category-content',
        category,
        categoryTitle: title,
        categoryDescription: description,
        categoryMod: mod
      }
    });
  }

  return paths;
}

const {
  pageType,
  category,
  categoryTitle,
  categoryDescription,
  categoryMod,
  posts,
  post
} = Astro.props;

const categoryDisplayName = categoryTitle || category;
const currentCategoryDesc = categoryDescription;

// For essay articles: extract TOC headings and author
let headings: any[] = [];
let author: string | undefined = undefined;

if (pageType === 'essay-article' && post) {
  author = post.frontmatter?.author;
  if (typeof post.getHeadings === 'function') {
    const rawHeadings = await post.getHeadings();
    headings = rawHeadings.filter((h: any) => h.depth >= 2 && h.depth <= 4);
  }
}

const CategoryContent = categoryMod?.Content;
const hasCategoryBody = Boolean(categoryMod?.rawContent?.()?.trim());
---

{pageType === 'essays-index' && (
  <Layout title={`Misc // ${categoryDisplayName} | SYS_ARCHITECT`}>
    <div>
      <a href="/misc" class="mono text-dim" style="font-size: 0.85rem; display: inline-block; margin-bottom: 2rem;">
        ← /misc
      </a>

      <div class="flex" style="justify-content: space-between; align-items: baseline; margin-bottom: 0.5rem; flex-wrap: wrap; gap: 0.5rem;">
        <h1 class="mono" style="margin: 0;">/{category}</h1>
        <span class="badge">{posts.length} {posts.length === 1 ? 'ESSAY' : 'ESSAYS'}</span>
      </div>

      {currentCategoryDesc && (
        <p class="text-dim mb-4">
          {currentCategoryDesc}
        </p>
      )}

      {hasCategoryBody && CategoryContent && (
        <div class="card mb-8 text-dim home-prose">
          <CategoryContent />
        </div>
      )}

      <div class="flex" style="flex-direction: column; gap: 2rem;">
        {posts.map((entry: any) => {
          const { title, date, description, readingTime } = entry.post.frontmatter || {};
          const articleUrl = `/misc/${entry.slugPath}`;
          const noteTitle = title || entry.slugPath.split('/').pop();

          return (
            <div class="card">
              <div class="flex" style="justify-content: space-between; align-items: baseline; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem;">
                <h2 class="mono" style="font-size: 1.2rem; margin: 0;">
                  <a href={articleUrl} class="project-title-link">
                    {noteTitle}
                  </a>
                </h2>
                <div class="flex gap-2" style="align-items: center;">
                  {date && <span class="mono text-dim" style="font-size: 0.8rem;">{date}</span>}
                  {readingTime && <span class="badge">{readingTime}</span>}
                </div>
              </div>

              {description && (
                <p class="text-dim" style="font-size: 0.95rem; margin-bottom: 0.75rem; line-height: 1.5;">
                  {description}
                </p>
              )}

              <div class="mono" style="border-top: 1px solid var(--border); padding-top: 0.75rem; margin-top: 1rem; font-size: 0.8rem;">
                <a href={articleUrl} class="tag-link badge">
                  Read →
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </Layout>
)}

{pageType === 'category-content' && (
  <Layout title={`${categoryDisplayName} | SYS_ARCHITECT`}>
    <div>
      <a href="/misc" class="mono text-dim" style="font-size: 0.85rem; display: inline-block; margin-bottom: 2rem;">
        ← /misc
      </a>

      <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
        <h1 class="mono" style="font-size: 1.8rem; margin-bottom: 0.5rem;">
          /{category}
        </h1>
        {currentCategoryDesc && (
          <p class="text-dim" style="font-size: 1rem; line-height: 1.6; margin-bottom: 0.75rem;">
            {currentCategoryDesc}
          </p>
        )}
      </div>

      {category === 'pictures' ? (
        <PicturesView frontmatter={categoryMod?.frontmatter} Content={CategoryContent} />
      ) : (
        <div class="blog-article-content text-dim">
          {CategoryContent && <CategoryContent />}
        </div>
      )}
    </div>
  </Layout>
)}

{pageType === 'essay-article' && (
  <Layout title={`${post.frontmatter?.title || 'Essay'} | SYS_ARCHITECT`}>
    <div class="article-layout">
      <!-- Main Content Column -->
      <div class="article-main">
        <a href={`/misc/${category}`} class="mono text-dim" style="font-size: 0.85rem; display: inline-block; margin-bottom: 2rem;">
          ← /misc/{category}
        </a>

        <div style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
          {post.frontmatter?.title && (
            <h1 class="mono article-page-title" style="font-size: 1.8rem; margin-bottom: 0.75rem;">
              {post.frontmatter.title}
            </h1>
          )}
          <div class="flex gap-4 mono text-dim" style="font-size: 0.8rem; align-items: center; flex-wrap: wrap;">
            {author && <span>AUTHOR: {author}</span>}
            {post.frontmatter?.date && <span>DATE: {post.frontmatter.date}</span>}
            {post.frontmatter?.readingTime && <span class="badge">{post.frontmatter.readingTime}</span>}
          </div>
        </div>

        {/* Mobile Accordion Table of Contents (Visible <= 1024px) */}
        {headings && headings.length > 0 && (
          <details class="mobile-toc-accordion mono card">
            <summary class="mobile-toc-summary">
              <span>[ Table of Contents ({headings.length}) ▾ ]</span>
            </summary>
            <nav class="mobile-toc-nav">
              {headings.map((h: any) => {
                const depthClass = h.depth === 3 ? 'toc-sub' : (h.depth === 4 ? 'toc-h4' : '');
                return (
                  <a 
                    href={`#${h.slug}`} 
                    class={`toc-link mono ${depthClass}`}
                  >
                    {h.text}
                  </a>
                );
              })}
            </nav>
          </details>
        )}

        <div class="blog-article-content text-dim">
          <post.Content />
        </div>
      </div>

      <!-- Opened Right-Side Table of Contents (Desktop only) -->
      {headings && headings.length > 0 && (
        <aside class="article-toc desktop-toc">
          <div class="toc-sticky">
            <span class="mono text-dim toc-header">Table of Contents</span>
            <nav class="toc-nav">
              {headings.map((h: any) => {
                const depthClass = h.depth === 3 ? 'toc-sub' : (h.depth === 4 ? 'toc-h4' : '');
                return (
                  <a 
                    href={`#${h.slug}`} 
                    class={`toc-link mono ${depthClass}`}
                    data-heading={h.slug}
                  >
                    {h.text}
                  </a>
                );
              })}
            </nav>
          </div>
        </aside>
      )}
    </div>
  </Layout>
)}

<script>
  function setupToc() {
    const headings = Array.from(
      document.querySelectorAll('.blog-article-content h2, .blog-article-content h3, .blog-article-content h4')
    ) as HTMLElement[];
    const tocLinks = Array.from(document.querySelectorAll('.desktop-toc .toc-link')) as HTMLAnchorElement[];

    if (!headings.length || !tocLinks.length) return;

    let isManualClick = false;
    let manualTimeout: any = null;
    let ticking = false;

    function applyActiveHighlight(activeSlug: string) {
      if (!activeSlug) return;
      let activeLink: HTMLAnchorElement | null = null;

      tocLinks.forEach((link) => {
        const slug = link.getAttribute('data-heading') || link.getAttribute('href')?.replace('#', '');
        if (slug === activeSlug) {
          link.classList.add('active');
          activeLink = link;
        } else {
          link.classList.remove('active');
        }
      });

      if (activeLink) {
        const tocContainer = document.querySelector('.toc-sticky');
        if (tocContainer) {
          const containerRect = tocContainer.getBoundingClientRect();
          const linkRect = (activeLink as HTMLAnchorElement).getBoundingClientRect();
          if (linkRect.top < containerRect.top || linkRect.bottom > containerRect.bottom) {
            (activeLink as HTMLAnchorElement).scrollIntoView({ block: 'nearest', behavior: 'smooth' });
          }
        }
      }
    }

    function calculateActiveHeading() {
      if (isManualClick) return;

      const triggerOffset = 160;
      let activeSlug = '';

      const isAtBottom = (window.innerHeight + window.scrollY) >= (document.documentElement.scrollHeight - 25);

      if (isAtBottom) {
        for (let i = headings.length - 1; i >= 0; i--) {
          if (headings[i].getBoundingClientRect().top < window.innerHeight) {
            activeSlug = headings[i].id;
            break;
          }
        }
      } else {
        for (let i = 0; i < headings.length; i++) {
          const rect = headings[i].getBoundingClientRect();
          if (rect.top <= triggerOffset) {
            activeSlug = headings[i].id;
          } else {
            break;
          }
        }
      }

      if (!activeSlug && headings.length > 0) {
        activeSlug = headings[0].id;
      }

      applyActiveHighlight(activeSlug);
      ticking = false;
    }

    function onScroll() {
      if (isManualClick) return;
      if (!ticking) {
        requestAnimationFrame(calculateActiveHeading);
        ticking = true;
      }
    }

    headings.forEach((h) => {
      h.addEventListener('click', () => {
        if (!h.id) return;
        isManualClick = true;
        clearTimeout(manualTimeout);
        history.pushState(null, '', `#${h.id}`);
        applyActiveHighlight(h.id);
        h.scrollIntoView({ behavior: 'smooth' });
        manualTimeout = setTimeout(() => {
          isManualClick = false;
        }, 700);
      });
    });

    tocLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const slug = link.getAttribute('data-heading') || link.getAttribute('href')?.replace('#', '');
        if (slug) {
          isManualClick = true;
          clearTimeout(manualTimeout);
          applyActiveHighlight(slug);
          manualTimeout = setTimeout(() => {
            isManualClick = false;
          }, 700);
        }
      });
    });

    window.addEventListener('scroll', onScroll, { passive: true });
    
    const initialHash = window.location.hash.replace('#', '');
    if (initialHash && headings.some(h => h.id === initialHash)) {
      applyActiveHighlight(initialHash);
    } else {
      calculateActiveHeading();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupToc);
  } else {
    setupToc();
  }
  document.addEventListener('astro:after-swap', setupToc);
</script>
