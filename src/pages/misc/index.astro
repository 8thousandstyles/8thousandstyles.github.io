---
import Layout from '../../layouts/Layout.astro';

interface NoteFrontmatter {
  title?: string;
  date?: string;
  description?: string;
  draft?: boolean;
}

// 1. Eagerly load misc top-level configuration from misc.md or misc/_index.md (these two only)
const configFiles = import.meta.glob<any>([
  '../../content/misc.md',
  '../../content/misc/_index.md'
], { eager: true });
const configEntry = Object.values(configFiles)[0];
const config = configEntry?.frontmatter || {};
const Content = configEntry?.Content;
const hasBodyContent = Boolean(configEntry?.rawContent?.()?.trim());

// NO FALLBACKS: Only render what is explicitly configured in .md
const pageTitle = config.title;
const pageDescription = config.description;

// 2. Read category-level metadata from <category>.md or <category>/_index.md (these two only)
const rawMisc = import.meta.glob<any>('../../content/misc/**/*.md', { eager: true });
const categoryMetaMap = new Map<string, { title?: string; description?: string }>();
const draftCategories = new Set<string>();

// Pass 1: Identify draft categories
for (const [filepath, mod] of Object.entries(rawMisc)) {
  const relPath = filepath.replace(/^.*\/content\/misc\//, '');
  if (relPath === '_index.md' || relPath === 'misc.md') continue;

  const parts = relPath.split('/');
  if (parts.length === 2 && parts[1] === '_index.md') {
    if (mod.frontmatter?.draft === true) {
      draftCategories.add(parts[0]);
    }
  } else if (parts.length === 1 && parts[0].endsWith('.md')) {
    if (mod.frontmatter?.draft === true) {
      draftCategories.add(parts[0].replace(/\.md$/, ''));
    }
  }
}

// Pass 2: Collect active (non-draft) categories
for (const [filepath, mod] of Object.entries(rawMisc)) {
  const relPath = filepath.replace(/^.*\/content\/misc\//, '');
  if (relPath === '_index.md' || relPath === 'misc.md') continue;

  const parts = relPath.split('/');
  let cat = '';
  if (parts.length === 2 && parts[1] === '_index.md') {
    cat = parts[0];
  } else if (parts.length === 1 && parts[0].endsWith('.md')) {
    cat = parts[0].replace(/\.md$/, '');
  }

  if (cat && !draftCategories.has(cat)) {
    categoryMetaMap.set(cat, {
      title: mod.frontmatter?.title,
      description: mod.frontmatter?.description
    });
  }
}

const categories = Array.from(categoryMetaMap.entries()).map(([key, data]) => {
  return {
    key,
    name: data.title || key,
    description: data.description,
  };
});

function renderMarkdownLinks(text: string): string {
  if (!text) return '';
  return text.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_match, linkText, url) => {
    const isExternal = url.startsWith('http://') || url.startsWith('https://') || url.startsWith('//');
    const targetRel = isExternal ? ' target="_blank" rel="noreferrer"' : '';
    return `<a href="${url}"${targetRel}>${linkText}</a>`;
  });
}
---

<Layout title={pageTitle ? `SYS_ARCHITECT | ${pageTitle}` : "SYS_ARCHITECT | Misc"}>
  <div>
    {pageTitle && <h1 class="mono">{pageTitle}</h1>}
    {pageDescription && (
      <p class="text-dim mb-4">
        {pageDescription}
      </p>
    )}

    {hasBodyContent && Content && (
      <div class="card mb-8 text-dim home-prose">
        <Content />
      </div>
    )}

    <!-- Categories Grid (Styled like home page focusAreas with subtle distinctions) -->
    {categories.length > 0 && (
      <div class="grid-2 mt-8">
        {categories.map((cat) => {
          const descHtml = renderMarkdownLinks(cat.description || '');
          return (
            <a href={`/misc/${cat.key}`} class="misc-category-item">
              <h3 class="mono misc-cat-title" style="margin: 0 0 0.4rem 0; font-size: 1.15rem;">
                /{cat.key}
                <span class="misc-arrow">→</span>
              </h3>

              {descHtml && (
                <p class="text-dim focus-area-desc" style="font-size: 0.9rem; line-height: 1.6; margin: 0;" set:html={descHtml} />
              )}
            </a>
          );
        })}
      </div>
    )}
  </div>
</Layout>

<style>
  .misc-category-item {
    text-decoration: none;
    color: inherit;
    display: block;
    border-left: 2px solid var(--border);
    padding: 0.5rem 0 0.5rem 1.25rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .misc-category-item:hover {
    border-left-color: var(--accent);
  }

  .misc-cat-title {
    color: var(--fg);
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .misc-category-item:hover .misc-cat-title {
    color: var(--accent);
  }

  .misc-arrow {
    display: inline-block;
    color: var(--accent);
    font-size: 0.95rem;
    opacity: 0.7;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .misc-category-item:hover .misc-arrow {
    transform: translateX(4px);
    opacity: 1;
  }
</style>
